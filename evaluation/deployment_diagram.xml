          style="edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=classic;endArrow=classic;strokeColor=#82b366;fontColor=#3a6b35;fontSize=10;exitX=1;exitY=0.8;entryX=0;entryY=0.5;"
          edge="1" source="fastapi" target="neonNode" parent="1">
