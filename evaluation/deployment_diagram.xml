          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Backend -> Vertex AI -->
        <mxCell id="e_backend_vertex"
          value="LLM + embedding API (HTTPS)"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=classic;endArrow=classic;strokeColor=#9673a6;fontColor=#6a3fa0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"
