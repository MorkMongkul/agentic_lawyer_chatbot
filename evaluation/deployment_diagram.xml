          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="460" y="160" width="250" height="80" as="geometry" />
