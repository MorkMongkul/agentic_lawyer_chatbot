          value="«device» = client hardware    «cloud» = cloud host    «service» = external managed service"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontStyle=2;fontColor=#666666;"
          vertex="1" parent="1">
          <mxGeometry x="80" y="540" width="700" height="20" as="geometry" />
        </mxCell>

