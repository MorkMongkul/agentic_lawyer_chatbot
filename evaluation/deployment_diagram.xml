          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Browser -> Nginx (HTTPS) -->
        <mxCell id="e_browser_nginx"
          value="HTTPS&#10;(443)"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=classic;endArrow=classic;strokeWidth=2;fontSize=11;fontStyle=1;"
          edge="1" source="browser" target="nginxBox" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="370" y="149" />
            </Array>
          </mxGeometry>
